<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UserSecretsId>aspnet-VeryLike-220d0dfd-dd49-49a0-b7ba-a8558ceca625</UserSecretsId>
		<!-- Web vive en la raíz del repo: sin esto, sus subcarpetas de proyecto
		     (Domain/Infrastructure) se compilarían también dentro de Web. -->
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
	</PropertyGroup>

	<ItemGroup>
		<!-- VeryLike.Web es un CONSUMIDOR: habla con Catalog.API y Forum.API
		     por HTTP (ver Services/), no referencia sus ensamblados. Solo
		     depende de Domain (modelos/DTOs compartidos) e Infrastructure
		     (EF Core, para Usuario/Auth, que sí vive en este proceso). -->
		<ProjectReference Include="VeryLike.Domain/VeryLike.Domain.csproj" />
		<ProjectReference Include="VeryLike.Infrastructure/VeryLike.Infrastructure.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="**/*.cs"
		         Exclude="VeryLike.Domain/**/*.cs;VeryLike.Infrastructure/**/*.cs;VeryLike.Catalog.API/**/*.cs;VeryLike.Forum.API/**/*.cs;bin/**/*.cs;obj/**/*.cs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

</Project>

