{
  "family": "verylike-web",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "REPLACE_WITH_ECS_EXECUTION_ROLE_ARN",
  "taskRoleArn": "REPLACE_WITH_ECS_TASK_ROLE_ARN",
  "containerDefinitions": [{
    "name": "web",
    "image": "REPLACE_AT_DEPLOY",
    "essential": true,
    "portMappings": [{ "containerPort": 8080, "protocol": "tcp" }],
    "environment": [
      { "name": "ASPNETCORE_ENVIRONMENT", "value": "Production" },
      { "name": "ServiceUrls__CatalogApi", "value": "http://catalog-api.verylike.local:8080/" },
      { "name": "ServiceUrls__ForumApi", "value": "http://forum-api.verylike.local:8080/" },
      { "name": "Database__ApplyMigrations", "value": "true" }
    ],
    "secrets": [
      { "name": "ConnectionStrings__DefaultConnection", "valueFrom": "verylike/database:connectionString::" },
      { "name": "Tmdb__ApiKey", "valueFrom": "verylike/tmdb:apiKey::" }
    ],
    "logConfiguration": {
      "logDriver": "awslogs",
      "options": { "awslogs-group": "/ecs/verylike", "awslogs-region": "REPLACE_WITH_AWS_REGION", "awslogs-stream-prefix": "web" }
    }
  }]
}
