@model VeryLike.Web.Models.ForoViewModel

@{
    ViewData["Title"] = "Comunidad";
    var hashtagActivo = Model.HashtagActivo;
    var usuarioSesion = Context.Session.GetString("UsuarioNombre");
}

<div class="container mt-5">
    <div class="text-center mb-5">
        <h1 class="display-6 fw-light text-uppercase" style="letter-spacing: 4px;">Comunidad</h1>
        <p class="text-muted small">Canal abierto de discusión cinematográfica</p>

        @if (!string.IsNullOrWhiteSpace(hashtagActivo))
        {
            <p class="small mb-0">
                Filtrando por <span style="color: var(--accent-color);">#@hashtagActivo</span>
                <a class="ms-2 text-muted" asp-action="Index">Quitar filtro</a>
            </p>
        }
    </div>

    @if (Model.ResenasRecientes.Any() && string.IsNullOrWhiteSpace(hashtagActivo))
    {
        <div class="glass-card p-4 mb-5" style="max-width: 800px; margin: 0 auto;">
            <h5 class="fw-light text-uppercase mb-3" style="letter-spacing: 2px;">Reseñas recientes</h5>
            @foreach (var resena in Model.ResenasRecientes)
            {
                <div class="mb-3 pb-2" style="border-bottom: 1px solid var(--border-glass);">
                    <div class="d-flex justify-content-between">
                        <a class="small text-decoration-none" style="color: var(--accent-color);"
                           asp-controller="Perfil" asp-action="Ver" asp-route-nombreUsuario="@resena.Usuario?.NombreUsuario">@resena.Usuario?.NombreUsuario</a>
                        <span class="small">@resena.Contenido?.Nombre · @resena.Puntaje / 5</span>
                    </div>
                    <p class="small text-muted mb-0">@resena.ResenaPublica</p>
                </div>
            }
        </div>
    }

    <div class="d-flex flex-column gap-4 mb-5" style="max-width: 800px; margin: 0 auto;">
        @if (Model.Mensajes.Any())
        {
            @foreach (var mensaje in Model.Mensajes)
            {
                <div class="glass-card p-4">
                    <div class="d-flex justify-content-between align-items-center mb-2" style="border-bottom: 1px solid var(--border-glass); padding-bottom: 8px;">
                        <a class="fw-normal text-decoration-none" style="color: var(--accent-color); font-size: 0.9rem;"
                           asp-controller="Perfil" asp-action="Ver" asp-route-nombreUsuario="@mensaje.NombreUsuario">@mensaje.NombreUsuario</a>
                        <span class="text-muted font-monospace" style="font-size: 0.75rem;">@mensaje.FechaPublicacion.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>

                    @if (mensaje.NombreUsuario == usuarioSesion)
                    {
                        <div class="d-flex justify-content-end gap-3 mb-2">
                            <button type="button" class="btn btn-sm p-0 small text-muted"
                                    data-bs-toggle="collapse" data-bs-target="#editar-@mensaje.Id">Editar</button>
                            <form asp-action="Eliminar" method="post"
                                  onsubmit="return confirm('¿Borrar esta publicación y sus comentarios?');">
                                <input type="hidden" name="id" value="@mensaje.Id" />
                                <button type="submit" class="btn btn-sm p-0 small text-muted">Borrar</button>
                            </form>
                        </div>

                        <form asp-action="Editar" method="post" class="collapse mb-3" id="editar-@mensaje.Id">
                            <input type="hidden" name="id" value="@mensaje.Id" />
                            <textarea name="contenido" class="form-control form-control-glass form-control-sm mb-2" rows="3" required>@mensaje.Contenido</textarea>
                            <button type="submit" class="btn btn-sm btn-futuristic">Guardar cambios</button>
                        </form>
                    }

                    <p class="mb-2 small" style="line-height: 1.6; white-space: pre-line;">@mensaje.Contenido</p>

                    @if (mensaje.Hashtags.Any())
                    {
                        <div class="mb-3">
                            @foreach (var etiqueta in mensaje.Hashtags)
                            {
                                <a class="me-2 small text-decoration-none"
                                   style="color: var(--accent-color);"
                                   asp-action="Index" asp-route-hashtag="@etiqueta">#@etiqueta</a>
                            }
                        </div>
                    }

                    @if (mensaje.Comentarios.Any())
                    {
                        <div class="ps-3 mb-3" style="border-left: 1px solid var(--border-glass);">
                            @foreach (var comentario in mensaje.Comentarios.OrderBy(c => c.FechaPublicacion))
                            {
                                <p class="mb-2" style="font-size: 0.8rem; line-height: 1.5;">
                                    <a class="text-decoration-none" style="color: var(--accent-color);"
                                       asp-controller="Perfil" asp-action="Ver" asp-route-nombreUsuario="@comentario.NombreUsuario">@comentario.NombreUsuario</a>:
                                    @comentario.Contenido
                                    @if (comentario.NombreUsuario == usuarioSesion)
                                    {
                                        <form asp-action="Eliminar" method="post" class="d-inline"
                                              onsubmit="return confirm('¿Borrar este comentario?');">
                                            <input type="hidden" name="id" value="@comentario.Id" />
                                            <button type="submit" class="btn btn-sm p-0 small text-muted">borrar</button>
                                        </form>
                                    }
                                </p>
                            }
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(usuarioSesion))
                    {
                        <form asp-action="Comentar" method="post" class="d-flex gap-2">
                            <input type="hidden" name="mensajePadreId" value="@mensaje.Id" />
                            <input type="text" name="contenido" class="form-control form-control-glass form-control-sm" placeholder="Comentar..." required />
                            <button type="submit" class="btn btn-sm btn-futuristic">Responder</button>
                        </form>
                    }
                </div>
            }
        }
        else
        {
            <div class="glass-card p-5 text-center">
                <div class="text-muted fw-light">SISTEMA DE DISCUSIÓN INICIALIZADO. SIN MENSAJES.</div>
            </div>
        }
    </div>

    <div class="text-center">
        @if (string.IsNullOrEmpty(usuarioSesion))
        {
            <p class="text-muted small mb-0">
                <a asp-controller="Auth" asp-action="Login" style="color: var(--accent-color);">Iniciá sesión</a> para publicar.
            </p>
        }
        else
        {
            <button type="button" class="btn btn-futuristic" data-bs-toggle="modal" data-bs-target="#modalPublicarForo">
                Participar en el foro
            </button>
        }
    </div>
</div>

@if (!string.IsNullOrEmpty(usuarioSesion))
{
    <div class="modal fade" id="modalPublicarForo" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content glass-card">
                <div class="modal-header" style="border-bottom: 1px solid var(--border-glass);">
                    <h5 class="modal-title fw-light text-uppercase" style="letter-spacing: 2px;">Participar en el Foro</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <form asp-action="Publicar" method="post">
                    <div class="modal-body">
                        <p class="text-muted small">Publicás como <span style="color: var(--accent-color);">@usuarioSesion</span></p>
                        <textarea name="Contenido" class="form-control form-control-glass" rows="5"
                                  placeholder="Escribe tu opinión o reseña aquí... (las etiquetas se generan solas)" required></textarea>
                    </div>
                    <div class="modal-footer" style="border-top: 1px solid var(--border-glass);">
                        <button type="button" class="btn btn-sm text-muted" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-futuristic">Enviar Mensaje</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
