@Html.AntiForgeryToken()
<div class="modal fade" id="modalDetalleMedia" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content glass-card" style="background: var(--menu-bg); border: 1px solid var(--border-glass);">

            <div class="modal-body p-4 text-white">

                <div id="vistaDetalles">
                    <div class="row">
                        <div class="col-md-4 text-center">
                            <div id="modalPortadaContenedor" class="media-poster mb-3" style="height: 250px; background-color: rgba(255,255,255,0.05); border-radius: 8px; overflow: hidden;">
                                <img id="modalPortadaImg" src="" alt="" class="d-none w-100 h-100" style="object-fit: cover;" />
                                <span id="modalPortadaTexto" class="text-muted" style="line-height: 250px;">PORTADA</span>
                            </div>

                            <p id="modalInfoTecnica" class="text-muted small mb-1 fw-bold tracking-widest text-uppercase"></p>

                            <div id="modalEstrellasContenedor" title="Calificación de la comunidad">
                                <span id="modalEstrellas" style="color: var(--accent-color); font-size: 1.2rem;"></span>
                            </div>
                            <h4 class="mt-1 fw-light" style="color: var(--text-main);"><span id="modalCalificacion">-</span> <span style="font-size: 0.8rem; color: var(--text-muted);">/ 5</span></h4>
                            <p id="modalTotalVotos" class="text-muted small mb-0"></p>

                            <a id="modalEnlaceStreaming" href="#" target="_blank" rel="noopener" class="btn btn-streaming btn-sm w-100 mt-2">Ver en streaming</a>
                        </div>

                        <div class="col-md-8 d-flex flex-column">
                            <h3 id="modalTitulo" class="fw-bold tracking-widest text-uppercase" style="color: var(--accent-color);">Título</h3>

                            <p class="text-muted small mb-2"><strong>Estudio:</strong> <span id="modalEstudio"></span></p>
                            <p id="modalSinopsis" style="color: var(--text-main); font-size: 0.9rem;"></p>

                            <div class="mb-3">
                                <span class="text-muted small d-block mb-1">Disponible en:</span>
                                <div id="modalPlataformas"></div>
                            </div>

                            <div class="mt-auto p-3 rounded" style="background: var(--input-bg); border: 1px solid var(--border-glass);">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="text-muted small text-uppercase tracking-widest">Comunidad</span>
                                </div>
                                <div id="modalResenas" class="mb-2"></div>
                                <div id="modalMiResenaPrivada" class="d-none mb-2 small" style="color: var(--text-muted);"></div>
                                <p class="mb-0" style="font-size: 0.85rem; color: var(--text-main);">Lee y comparte reseñas de otros cinéfilos en la <a asp-controller="Foro" asp-action="Index" style="color: var(--accent-color);">Comunidad</a>.</p>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-4 border-top pt-3" style="border-color: var(--border-glass) !important;">
                        <button type="button" class="btn text-muted" data-bs-dismiss="modal">Cerrar</button>
                        <button type="button" class="btn btn-futuristic" onclick="cambiarAVistaFormulario()">Calificar</button>
                    </div>
                </div>

                <div id="vistaFormulario" class="d-none">
                    <h4 class="text-center mb-4" style="color: var(--accent-color); letter-spacing: 2px;">TU CALIFICACIÓN</h4>

                    <div class="text-center mb-4">
                        <div id="modalEstrellasEditables" class="d-flex justify-content-center gap-2 mb-2">
                            <span class="star-rating" data-valor="1">★</span>
                            <span class="star-rating" data-valor="2">★</span>
                            <span class="star-rating" data-valor="3">★</span>
                            <span class="star-rating" data-valor="4">★</span>
                            <span class="star-rating" data-valor="5">★</span>
                        </div>
                        <p class="text-muted small">Haz clic en la mitad izquierda de una estrella para el .5 &mdash; <span id="modalPuntajeElegido">0</span> / 5</p>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small text-uppercase tracking-widest">Reseña Pública (Para el Foro)</label>
                        <textarea id="modalResenaPublica" class="form-control form-control-glass" rows="3" placeholder="¿Qué le dirías a la comunidad sobre esto?"></textarea>
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-muted small text-uppercase tracking-widest">Reseña Privada (Solo para ti)</label>
                        <textarea id="modalResenaPrivada" class="form-control form-control-glass" rows="2" placeholder="Notas personales que nadie más leerá..."></textarea>
                    </div>

                    <p id="modalMensajeCalificacion" class="small text-center" style="color: var(--accent-color);"></p>

                    <div class="d-flex justify-content-between border-top pt-3" style="border-color: var(--border-glass) !important;">
                        <button type="button" class="btn text-muted" onclick="cambiarAVistaDetalles()">Cancelar</button>
                        <button type="button" id="modalBotonGuardar" class="btn btn-futuristic">Guardar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
