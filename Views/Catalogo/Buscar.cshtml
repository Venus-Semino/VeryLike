@model VeryLike.Web.Models.BusquedaViewModel

@{
    ViewData["Title"] = "Buscar";
}

<div class="container mt-5">
    <h1 class="display-6 fw-light text-uppercase" style="letter-spacing: 4px;">Resultados</h1>
    <p class="text-muted small mb-4">
        @(string.IsNullOrWhiteSpace(Model.Consulta) ? "Escribe algo en el buscador del menú." : $"Búsqueda: \"{Model.Consulta}\"")
    </p>

    @if (Model.Usuarios.Any())
    {
        <h5 class="fw-light text-uppercase mb-3" style="letter-spacing: 2px;">Usuarios</h5>
        <div class="glass-card p-4 mb-5">
            @foreach (var usuario in Model.Usuarios)
            {
                <a class="d-block mb-2 text-decoration-none"
                   style="color: var(--accent-color);"
                   asp-controller="Perfil" asp-action="Ver" asp-route-nombreUsuario="@usuario.NombreUsuario">
                    @usuario.NombreUsuario
                </a>
            }
        </div>
    }

    @if (Model.Titulos.Any())
    {
        <h5 class="fw-light text-uppercase mb-3" style="letter-spacing: 2px;">Títulos</h5>
        <div class="row g-4">
            @foreach (var item in Model.Titulos)
            {
                <div class="col-6 col-md-3">
                    @await Html.PartialAsync("_TarjetaMedia", item)
                </div>
            }
        </div>
    }

    @if (Model.SinResultados && !string.IsNullOrWhiteSpace(Model.Consulta))
    {
        <div class="text-center py-5 text-muted fw-light">NO SE ENCONTRARON RESULTADOS.</div>
    }

    @await Html.PartialAsync("_ModalDetalles")
</div>

@section Scripts {
    <script src="~/js/pizarron.js" asp-append-version="true"></script>
}
