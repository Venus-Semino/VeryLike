@model IEnumerable<VeryLike.Domain.Models.ContenidoAudiovisual>
@{
    ViewData["Title"] = "Buscar";
    var consulta = ViewData["Consulta"] as string;
}

<div class="container mt-5">
    <h1 class="display-6 fw-light text-uppercase" style="letter-spacing: 4px;">Resultados</h1>
    <p class="text-muted small mb-4">
        @(string.IsNullOrWhiteSpace(consulta) ? "Escribe algo en el buscador del menú." : $"Búsqueda: \"{consulta}\"")
    </p>

    <div class="row g-4">
        @if (Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col-6 col-md-3">
                    @await Html.PartialAsync("_TarjetaMedia", item)
                </div>
            }
        }
        else if (!string.IsNullOrWhiteSpace(consulta))
        {
            <div class="col-12 text-center py-5">
                <div class="text-muted fw-light">NO SE ENCONTRARON TÍTULOS.</div>
            </div>
        }
    </div>

    @await Html.PartialAsync("_ModalDetalles")
</div>

@section Scripts {
    <script src="~/js/pizarron.js" asp-append-version="true"></script>
}
