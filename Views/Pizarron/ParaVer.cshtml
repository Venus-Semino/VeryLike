@model List<VeryLike.Domain.Models.ContenidoAudiovisual>
@{
    ViewData["Title"] = "Para Ver";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-5 flex-wrap gap-3">
        <div>
            <h1 class="display-6 fw-light text-uppercase" style="letter-spacing: 4px;">Mi Lista "Para Ver"</h1>
            <p class="text-muted small m-0">@Model.Count título(s) en tu lista</p>
        </div>
        <a asp-controller="Pizarron" asp-action="Index" class="text-muted small text-decoration-none">&larr; Volver al Pizarrón</a>
    </div>

    <div class="row g-5">
        @if (Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col-md-4 col-lg-3">
                    <div class="glass-card h-100 d-flex flex-column"
                         data-bs-toggle="modal" data-bs-target="#modalDetalleMedia"
                         style="cursor: pointer;"
                         data-tipo="@item.Tipo.ToLowerInvariant()"
                         data-titulo="@item.Nombre"
                         data-duracion="@(item is VeryLike.Domain.Models.Pelicula p ? p.Duracion : null)"
                         data-temporadas="@(item is VeryLike.Domain.Models.Serie s ? s.Temporadas.ToString() : null)"
                         data-sinopsis="@item.Sinopsis"
                         data-estudio="@item.Studio"
                         data-calificacion="@item.Calificacion"
                         data-poster="@item.PosterUrl"
                         data-enlace="@item.EnlaceStreaming"
                         data-plataformas="@item.PlataformaStreaming">
                        @if (!string.IsNullOrWhiteSpace(item.PosterUrl))
                        {
                            <img src="@item.PosterUrl" alt="Póster de @item.Nombre" class="cover-placeholder-img" style="height: 260px;" loading="lazy" />
                        }
                        else
                        {
                            <div class="cover-placeholder" style="height: 260px;">Sin Portada</div>
                        }

                        <div class="p-3 d-flex flex-column flex-grow-1">
                            <h6 class="mb-1 text-truncate">@item.Nombre</h6>
                            <span class="text-muted small mb-2">@(item.Tipo == "Pelicula" ? "Película" : "Serie") · @item.AnioPublicacion</span>

                            <form asp-controller="Pizarron" asp-action="QuitarDeParaVer" method="post" class="mt-auto" onclick="event.stopPropagation();">
                                <input type="hidden" name="contenidoId" value="@item.Id" />
                                <button type="submit" class="btn btn-sm w-100" style="border: 1px solid var(--border-glass); color: var(--text-muted);">Quitar de la lista</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <p class="text-muted fw-light mb-3">TU LISTA "PARA VER" ESTÁ VACÍA.</p>
                <a asp-controller="Peliculas" asp-action="Index" class="btn btn-futuristic">Explorar Catálogo</a>
            </div>
        }
    </div>

    @await Html.PartialAsync("_ModalDetalles")

    @section Scripts {
        <script src="~/js/pizarron.js" asp-append-version="true"></script>
    }
</div>
