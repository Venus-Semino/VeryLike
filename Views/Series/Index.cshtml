@model IEnumerable<VeryLike.Domain.Models.Serie>
@{
    ViewData["Title"] = "Series";
    var generos = ViewData["Generos"] as List<string> ?? new List<string>();
    var generoSeleccionado = ViewData["GeneroSeleccionado"] as string;
}

<div class="container mt-5">
    <div class="text-center mb-4">
        <h1 class="display-6 fw-light text-uppercase" style="letter-spacing: 4px;">Series</h1>
        <p class="text-muted small">Catálogo de producciones por temporadas</p>

        @if (TempData["MensajeCatalogo"] is string mensaje)
        {
            <p class="small" style="color: var(--accent-color);">@mensaje</p>
        }

        <form asp-controller="Catalogo" asp-action="Sincronizar" method="post" class="d-inline">
            <input type="hidden" name="origen" value="Series" />
            <button type="submit" class="btn btn-futuristic btn-sm">Traer títulos desde TMDB</button>
        </form>
    </div>

    <form method="get" asp-action="Index" class="d-flex justify-content-center align-items-center gap-3 mb-5 flex-wrap">
        <label for="genero" class="text-muted small text-uppercase" style="letter-spacing: 1px;">Filtrar por género</label>
        <select id="genero" name="genero" class="filtro-genero-select" onchange="this.form.submit()">
            <option value="">Todos</option>
            @foreach (var g in generos)
            {
                if (g == generoSeleccionado)
                {
                    <option value="@g" selected>@g</option>
                }
                else
                {
                    <option value="@g">@g</option>
                }
            }
        </select>
        @if (!string.IsNullOrEmpty(generoSeleccionado))
        {
            <a asp-action="Index" class="text-muted small text-decoration-none">Quitar filtro &times;</a>
        }
    </form>

    <div class="row g-5 mb-5">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col-md-4">
                    <div class="glass-card h-100 d-flex flex-column"
                         data-bs-toggle="modal" data-bs-target="#modalDetalleMedia"
                         style="cursor: pointer;"
                         data-id="@item.Id"
                         data-tipo="serie"
                         data-titulo="@item.Nombre"
                         data-temporadas="@item.Temporadas"
                         data-sinopsis="@item.Sinopsis"
                         data-estudio="@item.Studio"
                         data-calificacion="@item.Calificacion"
                         data-poster="@item.PosterUrl"
                         data-enlace="@item.EnlaceStreaming"
                         data-plataformas="@item.PlataformaStreaming">
                        @if (!string.IsNullOrWhiteSpace(item.PosterUrl))
                        {
                            <img src="@item.PosterUrl" alt="Póster de @item.Nombre" class="cover-placeholder-img" loading="lazy" />
                        }
                        else
                        {
                            <div class="cover-placeholder">Sin Imagen de Portada</div>
                        }

                        <div class="p-4 d-flex flex-column flex-grow-1">
                            <h5 class="fw-normal mb-1">@item.Nombre</h5>
                            <span class="text-muted small mb-3" style="letter-spacing: 1px;">@item.PlataformaStreaming</span>

                            <h6 class="mb-3 font-monospace small" style="color: var(--accent-color);">@string.Join(" / ", item.Genero) | @item.AnioPublicacion</h6>
                            <p class="text-muted small flex-grow-1" style="line-height: 1.6;">@item.Sinopsis</p>

                            <div class="d-flex justify-content-between align-items-center mt-3 pt-3" style="border-top: 1px solid var(--border-glass);">
                                <span class="small text-muted">Temporadas: @item.Temporadas • @item.Studio</span>
                                <span class="fw-bold" style="color: var(--accent-color);">@item.Calificacion / 5</span>
                            </div>

                            <a href="@item.EnlaceStreaming" target="_blank" rel="noopener" class="btn btn-streaming w-100 mt-3" onclick="event.stopPropagation();">
                                Ver en @(string.IsNullOrWhiteSpace(item.PlataformaStreaming) ? "streaming" : item.PlataformaStreaming)
                            </a>

                            @await Html.PartialAsync("_BotonParaVer", item.Id)
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <div class="text-muted fw-light">NO HAY SERIES QUE COINCIDAN CON ESE FILTRO.</div>
            </div>
        }
    </div>

    @await Html.PartialAsync("_ModalDetalles")

    @section Scripts {
        <script src="~/js/pizarron.js" asp-append-version="true"></script>
    }
</div>
