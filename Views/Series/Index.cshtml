@model IEnumerable<VeryLike.Domain.Models.Serie>
@{
    ViewData["Title"] = "Series";
}

<div class="container mt-5">
    <div class="text-center mb-5">
        <h1 class="display-6 fw-light text-uppercase" style="letter-spacing: 4px;">Series</h1>
        <p class="text-muted small">Catálogo de Producciones por Temporadas</p>
    </div>

    <div class="row g-5 mb-5">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col-md-4">
                    <div class="glass-card h-100 d-flex flex-column">
                        <div class="cover-placeholder">
                            Sin Imagen de Portada
                        </div>

                        <div class="p-4 d-flex flex-column flex-grow-1">
                            <h5 class="fw-normal mb-1">@item.Nombre</h5>
                            <span class="text-muted small mb-3" style="letter-spacing: 1px;">@item.PlataformaStreaming</span>

                            <h6 class="mb-3 font-monospace small" style="color: var(--accent-color);">@string.Join(" / ", item.Genero) | @item.AnioPublicacion</h6>
                            <p class="text-muted small flex-grow-1" style="line-height: 1.6;">@item.Sinopsis</p>

                            <div class="d-flex justify-content-between align-items-center mt-3 pt-3" style="border-top: 1px solid var(--border-glass);">
                                <span class="small text-muted">Temporadas: @item.Temporadas • @item.Studio</span>
                                <span class="fw-bold" style="color: var(--accent-color);">@item.Calificacion / 5</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <div class="text-muted fw-light">SISTEMA INICIALIZADO. BASE DE DATOS VACÍA.</div>
            </div>
        }
    </div>

    <div class="glass-card p-5 mt-5 text-center">
        <p class="text-muted small mb-0">
            El catálogo se gestiona desde <strong>VeryLike.Catalog.API</strong> (catalogo.json).
            Por ahora es de solo lectura desde la Web; agregar títulos nuevos será el siguiente paso.
        </p>
    </div>
</div>