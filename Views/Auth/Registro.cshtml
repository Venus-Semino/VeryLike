@model VeryLike.Domain.Models.Usuario
@{
    ViewData["Title"] = "Crear Cuenta";
}

<style>
    /* Animación horizontal para flashcards */
    .flashcard-track {
        display: flex;
        gap: 20px;
        animation: scrollHorizontal 20s linear infinite;
        width: max-content;
    }

    @@keyframes scrollHorizontal {
        0% {
            transform: translateX(0);
        }

        100% {
            transform: translateX(-50%);
        }
    }
</style>

<div class="row align-items-center" style="min-height: 80vh;">
    <div class="col-md-6 pe-md-5">
        <h2 class="fw-light mb-4 text-uppercase" style="letter-spacing: 2px;">Únete a <span style="color: var(--accent-color);">VeryLike</span></h2>

        <form asp-action="Registro" method="post" class="glass-card p-5">
            <div class="mb-4">
                <input asp-for="Correo" type="email" class="form-control form-control-glass" placeholder="Correo electrónico" required />
            </div>
            <div class="mb-4">
                <input asp-for="NombreUsuario" type="text" class="form-control form-control-glass" placeholder="Crea un nombre de usuario" required />
                <span asp-validation-for="NombreUsuario" class="text-danger small mt-2 d-block"></span>
            </div>
            <div class="mb-5">
                <input asp-for="Contrasena" type="password" class="form-control form-control-glass" placeholder="Crea tu contraseña" required />
            </div>

            <div class="d-flex justify-content-between align-items-center">
                <a asp-controller="Home" asp-action="Index" class="text-muted text-decoration-none small text-uppercase" style="letter-spacing: 1px;">&lt; Regresar</a>
                <button type="submit" class="btn btn-futuristic">Registrarse</button>
            </div>
        </form>
    </div>

    <div class="col-md-6 overflow-hidden d-none d-md-block">
        <div class="flashcard-track">
            @for (int i = 0; i < 2; i++)
            {
                <div class="glass-card" style="width: 300px; height: 400px; background: linear-gradient(135deg, var(--surface-glass), transparent);">
                    <div class="p-4 d-flex flex-column h-100 justify-content-center text-center text-muted">
                        <h4 class="fw-light">Tu Pizarrón</h4>
                        <p class="small">Todo tu contenido organizado.</p>
                    </div>
                </div>
                <div class="glass-card" style="width: 300px; height: 400px; background: linear-gradient(135deg, transparent, var(--border-glass));">
                    <div class="p-4 d-flex flex-column h-100 justify-content-center text-center text-muted">
                        <h4 class="fw-light">Comunidad Viva</h4>
                        <p class="small">Debates y recomendaciones.</p>
                    </div>
                </div>
                <div class="glass-card" style="width: 300px; height: 400px; background: linear-gradient(135deg, var(--surface-glass), transparent);">
                    <div class="p-4 d-flex flex-column h-100 justify-content-center text-center text-muted">
                        <h4 class="fw-light">Recomendaciones IA</h4>
                        <p class="small">Descubre tu próxima obsesión.</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>